# Copy to .env (cp config.sample.env .env) and fill in.

# --- Mock IDV vendor ---
PORT=3000
# Public HTTPS URL Okta can reach (ngrok / cloudflared). No trailing slash.
IDV_BASE_URL=https://your-tunnel.ngrok-free.app
# Credentials Okta will use against this vendor (make up any values)
IDV_CLIENT_ID=demo-okta-client
IDV_CLIENT_SECRET=change-me-demo-secret
# Branding shown in the verification UI
IDV_BRAND_NAME=Acme Verify

# --- Okta tenant (only used by scripts/okta-setup.js) ---
OKTA_ORG_URL=https://your-org.okta.com
OKTA_API_TOKEN=
# Group whose members get IDV on authenticator enroll / password recovery
OKTA_TEST_GROUP_ID=
